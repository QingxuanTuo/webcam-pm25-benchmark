# macOS metadata
.DS_Store
**/.DS_Store

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Local diagnostic notebooks used for thesis sensitivity analyses
notebooks/diagnostics/

# Publish the final Nanjing workflow, ERA5 input and result tables only
/external validation/*
!/external validation/README.md
!/external validation/01_nanjing_external_validation_cv_holdout.ipynb
!/external validation/Nanjing/
/external validation/Nanjing/*
!/external validation/Nanjing/nanjing_era5_hourly.csv
!/external validation/results/
/external validation/results/*
!/external validation/results/nanjing_cv_holdout/
/external validation/results/nanjing_cv_holdout/*
!/external validation/results/nanjing_cv_holdout/*.csv

# Local plotting and utility scripts are kept locally only
scripts/

# Diagnostic outputs retained locally only
results/model_regularization_diagnostic/
results/target_distribution_diagnostic/
results/cnn_optimization_diagnostic/
results/date_split_sensitivity_analysis/
results/day_night_diagnostic/

# IDE and editor settings
.vscode/
.idea/

# reports are kept locally only
docs/

# Raw datasets are distributed separately
data/raw/*
!data/raw/samples/
!data/raw/samples/**

# Generated model artifacts and embedding caches
results/**/*.npz
results/**/*.pt
